# 复制为 .env 后填写；Node 24 支持 --env-file=.env。
PUBLIC_ORIGIN=http://127.0.0.1:3000
PORT=3000
FLOWUS_ROOT_ID=replace-with-dedicated-folder-uuid
FLOWUS_UPLOAD_PAGE_ID=replace-with-the-same-folder-uuid
FLOWUS_WORKSPACE_ID=replace-with-authorized-workspace-uuid
# 运行 ops/init-native.mjs 后，将输出的设置页ID填入此处。
FLOWUS_NATIVE_ROOT_ID=
# 必须是绝对路径；OAuth目录权限0700，credentials.json权限0600。
FLOWUS_CONFIG_DIR=/absolute/path/to/flowus-excalidraw-embedding/oauth-state
FLOWUS_CLI_PATH=/absolute/path/to/flowus
PASSWORD_HASH_FILE=./secrets/password-hash
SESSION_SECRET_FILE=./secrets/session-secret
DRAW_READ_ONLY=0
# 缩略图可丢弃；留空时只用内存缓存。
THUMBNAIL_CACHE_DIR=
